<?xml version="1.0" encoding="UTF-8"?>
<!-- Global Maven settings for the workflows (passed with MAVEN_ARGS=global-settings, so they are merged with the user
     settings written by actions/setup-java): credentials to read the HAPI FHIR build from GitHub Packages, see the
     'github' repository in the root pom.xml. The job needs the permission 'packages: read'. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
